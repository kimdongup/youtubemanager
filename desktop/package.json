{
  "name": "youtubemanager-desktop",
  "version": "1.0.0",
  "description": "YouTube Manager Pro - Native macOS Desktop Application",
  "main": "main.cjs",
  "scripts": {
    "start": "electron .",
    "build:mac": "electron-builder --mac"
  },
  "devDependencies": {
    "electron": "^34.2.0",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "com.youtubemanager.pro",
    "productName": "YouTube Manager Pro",
    "mac": {
      "category": "public.app-category.video",
      "target": ["dmg", "zip"]
    },
    "files": [
      "main.cjs"
    ],
    "extraResources": [
      {
        "from": "../backend/dist",
        "to": "backend/dist"
      },
      {
        "from": "../backend/node_modules/better-sqlite3",
        "to": "backend/node_modules/better-sqlite3"
      },
      {
        "from": "../backend/node_modules/bindings",
        "to": "backend/node_modules/bindings"
      },
      {
        "from": "../backend/node_modules/file-uri-to-path",
        "to": "backend/node_modules/file-uri-to-path"
      },
      {
        "from": "../frontend/dist",
        "to": "frontend/dist"
      }
    ],
    "directories": {
      "output": "../dist-desktop"
    }
  }
}

{
  "name": "youtubemanager-backend",
  "version": "1.0.0",
  "description": "High-performance memory-efficient backend for YouTube Manager",
  "main": "dist/server.js",
  "scripts": {
    "build": "tsc && npm run bundle",
    "bundle": "esbuild src/server.ts --bundle --platform=node --target=node20 --outfile=dist/server.bundle.cjs --external:better-sqlite3",
    "start": "node dist/server.js",
    "dev": "tsx watch src/server.ts"
  },
  "dependencies": {
    "better-sqlite3": "^11.8.1",
    "chokidar": "^4.0.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "fluent-ffmpeg": "^2.1.3",
    "googleapis": "^176.0.0"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.12",
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/fluent-ffmpeg": "^2.1.27",
    "@types/node": "^22.13.5",
    "esbuild": "^0.28.2",
    "tsx": "^4.19.3",
    "typescript": "^5.7.3"
  }
}
